export default function ConfirmationCard({ action, onApprove, onReject, onEdit, busy }) {
  const [editing, setEditing] = useState(false);
  const lines = action.summary.lines || [];
  const [edits, setEdits] = useState(
    lines.map((l) => ({
      amount: l.amount,
      category: l.category,
      project_code: l.project_code,
      notes: l.notes || '',
      justification: l.justification || '',
    })),
  );

  const onEditChange = (index, field, value) => {
    setEdits((prev) => prev.map((e, i) => (i === index ? { ...e, [field]: value } : e)));
  };

  const saveEdit = () => {
    const patches = edits.map((e, i) => ({
      line_index: i,
      amount: Number(e.amount),
      category: e.category,
      project_code: e.project_code,
      notes: e.notes,
      justification: e.justification,
    }));
    onEdit(patches);
    setEditing(false);
  };

  return (
    <section className="card" aria-label="Pending action confirmation">
      <header className="card-head">
        <h2>Review before filing</h2>
        <span className="pill">action {action.action_id}</span>
      </header>
      {action.needs_justification && (
        <p className="warn">One or more lines need a justification before this can be approved.</p>
      )}
      {action.summary.injection_suspicious && (
        <p className="warn">Note: suspicious instructions were found in the receipt text and ignored.</p>
      )}

      <div className="lines">
        {lines.map((line, i) => (
          <LineRow key={i} line={line} index={i} edit={editing ? edits[i] : null} onEditChange={onEditChange} />
        ))}
      </div>

      <div className="card-actions">
        {!editing ? (
          <>
            <button className="btn primary" disabled={busy || action.needs_justification} onClick={() => onApprove(action)}>
              Approve
            </button>
            <button className="btn" disabled={busy} onClick={() => setEditing(true)}>Edit</button>
            <button className="btn danger" disabled={busy} onClick={() => onReject(action)}>Reject</button>
          </>
        ) : (
          <>
            <button className="btn primary" disabled={busy} onClick={saveEdit}>Save changes</button>
            <button className="btn" disabled={busy} onClick={() => setEditing(false)}>Cancel</button>
          </>
        )}
      </div>
      <p className="hash">payload hash: {action.payload_hash.slice(0, 16)}…</p>
    </section>
  );
}
