## PHASE 4 — HITL pending-action store and the approved-payload executor

The only path from a staged write to a real API call: a hash-bound pending-action store (approve/reject/supersede) and an executor that replays an approved payload against the mock API.

**Create `filemate/backend/app/hitl.py`** with exactly this content:

```python
"""Human-in-the-loop gate.

A write tool never executes when the model calls it. Instead the backend stores a
*pending action*: an ID, the exact ordered write payload, and the time it was
created. The UI shows that payload on a confirmation card. Only an explicit
Approve executes the stored payload, and only if it still matches what was shown
(a hash binds the two). Edit supersedes the old action with a new one; Reject
discards it. This store is the single place a write can turn into an API call.
"""

from __future__ import annotations

import hashlib
import json
import time
import uuid
from dataclasses import dataclass, field
from typing import Any

STATUS_PENDING = "pending"
STATUS_APPROVED = "approved"
STATUS_REJECTED = "rejected"
STATUS_SUPERSEDED = "superseded"


def _hash_operations(operations: list[dict[str, Any]]) -> str:
    canonical = json.dumps(operations, sort_keys=True, separators=(",", ":"), default=str)
    return hashlib.sha256(canonical.encode("utf-8")).hexdigest()


class HitlError(Exception):
    def __init__(self, message: str) -> None:
        super().__init__(message)
        self.message = message


@dataclass
class PendingAction:
    id: str
    trace_id: str
    created_at: float
    operations: list[dict[str, Any]]
    summary: dict[str, Any]
    needs_justification: bool
    status: str = STATUS_PENDING
    payload_hash: str = ""
    superseded_by: str | None = None

    def card(self) -> dict[str, Any]:
        """Exactly what will be written, for the confirmation card."""
        return {
            "action_id": self.id,
            "trace_id": self.trace_id,
            "created_at": self.created_at,
            "status": self.status,
            "needs_justification": self.needs_justification,
            "payload_hash": self.payload_hash,
            "operations": self.operations,
            "summary": self.summary,
        }


class HitlStore:
    def __init__(self) -> None:
        self._actions: dict[str, PendingAction] = {}

    def create(
        self,
        *,
        trace_id: str,
        operations: list[dict[str, Any]],
        summary: dict[str, Any],
        needs_justification: bool,
    ) -> PendingAction:
        action = PendingAction(
            id=f"act-{uuid.uuid4().hex[:10]}",
            trace_id=trace_id,
            created_at=time.time(),
            operations=operations,
            summary=summary,
            needs_justification=needs_justification,
            payload_hash=_hash_operations(operations),
        )
        self._actions[action.id] = action
        return action

    def get(self, action_id: str) -> PendingAction:
        action = self._actions.get(action_id)
        if not action:
            raise HitlError(f"No pending action {action_id}")
        return action

    def approve(self, action_id: str, *, expected_hash: str | None = None) -> PendingAction:
        action = self.get(action_id)
        if action.status != STATUS_PENDING:
            raise HitlError(f"Action {action_id} is {action.status}, not pending; approval is invalid.")
        if action.needs_justification:
            raise HitlError("A justification is required before this action can be approved.")
        current = _hash_operations(action.operations)
        if current != action.payload_hash:
            raise HitlError("The payload changed after it was shown; approval is invalid.")
        if expected_hash is not None and expected_hash != action.payload_hash:
            raise HitlError("Approval does not match the payload that was shown; approval is invalid.")
        action.status = STATUS_APPROVED
        return action

    def reject(self, action_id: str) -> PendingAction:
        action = self.get(action_id)
        if action.status != STATUS_PENDING:
            raise HitlError(f"Action {action_id} is {action.status}; cannot reject.")
        action.status = STATUS_REJECTED
        return action

    def supersede(self, action_id: str, new_id: str) -> PendingAction:
        action = self.get(action_id)
        action.status = STATUS_SUPERSEDED
        action.superseded_by = new_id
        return action
```

**Create `filemate/backend/app/executor.py`** with exactly this content:

```python
"""Executes an approved pending action: replays the stored write ops against the API.

This is the only path that turns a staged write into a real API call, and it only
runs after HITL approval. It replays the exact stored operations in order,
resolving the draft report ID created in the first step. The success reply is
built here from the real API result, so "filed" is only ever said on real success.
"""

from __future__ import annotations

from typing import Any

from .mock_expense_api import ExpenseApiError, MockExpenseApi
from .observability import Observatory, Run, Stopwatch


class ExecutionError(Exception):
    def __init__(self, message: str) -> None:
        super().__init__(message)
        self.message = message


def execute(operations: list[dict[str, Any]], *, api: MockExpenseApi, obs: Observatory, run: Run) -> dict[str, Any]:
    report_id: str | None = None
    line_count = 0

    for op in operations:
        tool = op["tool"]
        args = dict(op.get("args", {}))
        with Stopwatch() as sw:
            try:
                if tool == "create_report":
                    result = api.create_report(args["employee_id"])
                    report_id = result["id"]
                elif tool == "add_line":
                    if report_id is None:
                        raise ExpenseApiError(400, "No draft report to add a line to")
                    line = {k: v for k, v in args.items() if k != "justification"}
                    result = api.add_line(report_id, line)
                    line_count += 1
                elif tool == "submit_report":
                    if report_id is None:
                        raise ExpenseApiError(400, "No draft report to submit")
                    result = api.submit_report(report_id)
                else:
                    raise ExecutionError(f"Unknown operation {tool!r}")
                status = "ok"
            except ExpenseApiError as exc:
                obs.log_tool(run, name=tool, args=args, status=f"error_{exc.status}", latency_ms=sw.elapsed_ms)
                raise ExecutionError(exc.message) from exc
        obs.log_tool(run, name=tool, args=args, status=status, latency_ms=sw.elapsed_ms)

    return {"report_id": report_id, "line_count": line_count, "status": "submitted" if report_id else "none"}
```

