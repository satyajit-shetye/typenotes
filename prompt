## PHASE 3 — Guardrails (all checks, in code)

Every guardrail as a pure, independently testable function: input checks, injection detection, scope/authorization, tool-argument validation, numeric policy, categorical policy rules (alcohol reject, hotel itemised note), and duplicate detection.

**Create `filemate/backend/app/guardrails.py`** with exactly this content:

```python
"""Guardrails, all enforced here in code rather than only asked of the model.

Layers:
  * input checks            - before the LLM is ever called
  * injection detection     - receipt text is data; embedded instructions are flagged
  * scope / authorization   - off-topic and other-employee requests are refused
  * tool-argument checks    - run before any write reaches the mock API
  * policy check            - over-limit lines are flagged and need a justification
  * output check            - "filed" is only ever said from a real API success

The agent is told about these rules too, but nothing here depends on the model
choosing to obey: a failed check returns a clear message and the call stops.
"""

from __future__ import annotations

import re
from dataclasses import dataclass, field
from datetime import date

from .config import ALLOWED_CURRENCY, MAX_INPUT_CHARS, RECEIPT_MAX_AGE_DAYS, SESSION_EMPLOYEE_ID
from .mock_expense_api import ExpenseApiError, MockExpenseApi


@dataclass
class GuardrailResult:
    ok: bool
    check: str
    reason: str = ""
    detail: dict = field(default_factory=dict)

    @classmethod
    def passed(cls, check: str) -> "GuardrailResult":
        return cls(ok=True, check=check)


# ---- Input checks (before the LLM call) --------------------------------------
def check_input(message: object) -> GuardrailResult:
    if not isinstance(message, str):
        return GuardrailResult(False, "input.text", "Input must be text.")
    stripped = message.strip()
    if not stripped:
        return GuardrailResult(False, "input.empty", "Message is empty.")
    if not re.search(r"[A-Za-z0-9]", stripped):
        return GuardrailResult(False, "input.text", "Message has no readable text.")
    if len(message) > MAX_INPUT_CHARS:
        return GuardrailResult(
            False,
            "input.length",
            f"Message is {len(message)} characters; the limit is {MAX_INPUT_CHARS}.",
            {"length": len(message), "max": MAX_INPUT_CHARS},
        )
    return GuardrailResult.passed("input")


# ---- Prompt-injection detection ----------------------------------------------
_INJECTION_PATTERNS = [
    r"ignore (the |all |previous |prior )?(policy|rules|instructions)",
    r"disregard (the |all |previous )?(policy|rules|instructions)",
    r"note to (the )?assistant",
    r"\bsystem\s*:",
    r"you are now",
    r"without asking",
    r"do not ask",
    r"skip (the )?approval",
    r"submit .*now",
    r"change (the )?amount to",
    r"override",
]
_INJECTION_RE = [re.compile(p, re.IGNORECASE) for p in _INJECTION_PATTERNS]


def detect_injection(receipt_text: str) -> GuardrailResult:
    """Return ok=True with suspicious markers in detail; the caller logs and ignores them."""
    matches = [rx.pattern for rx in _INJECTION_RE if rx.search(receipt_text)]
    if matches:
        return GuardrailResult(
            True,
            "injection",
            "Receipt text contains instruction-like content; treated as data and ignored.",
            {"suspicious": True, "patterns": matches},
        )
    return GuardrailResult(True, "injection", detail={"suspicious": False})


# ---- Scope / authorization ---------------------------------------------------
_OTHER_EMPLOYEE_RE = re.compile(r"\bE\d{3,}\b", re.IGNORECASE)
# Known co-worker names that are not the signed-in user.
_OTHER_NAMES = ["ravi", "menon"]
_OFF_TOPIC_RE = [
    re.compile(r"\b(write|compose|tell)\b.*\b(poem|story|joke|song|essay)\b", re.IGNORECASE),
    re.compile(r"\bweather\b", re.IGNORECASE),
]


def check_scope(message: str) -> GuardrailResult:
    """Refuse off-topic requests and anything about another employee's expenses."""
    for rx in _OTHER_EMPLOYEE_RE.finditer(message):
        if rx.group(0).upper() != SESSION_EMPLOYEE_ID:
            return GuardrailResult(
                False,
                "scope.other_employee",
                "I can only work with your own expenses.",
                {"mentioned": rx.group(0)},
            )
    lowered = message.lower()
    if any(name in lowered for name in _OTHER_NAMES):
        return GuardrailResult(
            False,
            "scope.other_employee",
            "I can only work with your own expenses.",
            {"mentioned_name": True},
        )
    if any(rx.search(message) for rx in _OFF_TOPIC_RE):
        return GuardrailResult(
            False,
            "scope.off_topic",
            "I can only help with filing your expense reports.",
        )
    return GuardrailResult.passed("scope")


def check_read_scope(requested_employee_id: str) -> GuardrailResult:
    """A read tool may only ever query the signed-in employee's data."""
    if requested_employee_id != SESSION_EMPLOYEE_ID:
        return GuardrailResult(
            False,
            "scope.other_employee",
            "Reads are restricted to the signed-in employee.",
            {"requested": requested_employee_id},
        )
    return GuardrailResult.passed("scope.read")


# ---- Tool-argument checks (before any API call) ------------------------------
ALLOWED_CATEGORIES = {"Meals", "Local travel", "Hotel", "Client entertainment"}


def validate_line_args(line: dict, api: MockExpenseApi, today: date | None = None) -> GuardrailResult:
    today = today or date.today()

    amount = line.get("amount")
    if not isinstance(amount, (int, float)) or amount <= 0:
        return GuardrailResult(False, "arg.amount", "Amount must be greater than zero.", {"amount": amount})

    raw_date = line.get("date")
    try:
        line_date = raw_date if isinstance(raw_date, date) else date.fromisoformat(str(raw_date))
    except ValueError:
        return GuardrailResult(False, "arg.date", f"Date {raw_date!r} is not a valid date.")
    if line_date > today:
        return GuardrailResult(False, "arg.date", "Receipt date is in the future.", {"date": str(line_date)})
    if (today - line_date).days > RECEIPT_MAX_AGE_DAYS:
        return GuardrailResult(
            False,
            "arg.date",
            f"Receipt date is older than {RECEIPT_MAX_AGE_DAYS} days.",
            {"date": str(line_date)},
        )

    category = line.get("category")
    if category not in ALLOWED_CATEGORIES:
        return GuardrailResult(False, "arg.category", f"Category {category!r} is not allowed.")

    currency = line.get("currency")
    if currency != ALLOWED_CURRENCY:
        return GuardrailResult(False, "arg.currency", f"Currency must be {ALLOWED_CURRENCY}.", {"currency": currency})

    code = str(line.get("project_code", ""))
    try:
        project = api.get_project(code)
    except ExpenseApiError as exc:
        return GuardrailResult(False, "arg.project", exc.message, {"project_code": code})
    if project["status"] != "active":
        return GuardrailResult(
            False,
            "arg.project",
            f"Project {project['code']} is {project['status']}.",
            {"project_code": code, "status": project["status"]},
        )

    return GuardrailResult.passed("arg")


# ---- Policy check -------------------------------------------------------------
@dataclass
class PolicyFinding:
    over_limit: bool
    limit: float | None
    needs_justification: bool
    message: str


def policy_check(line: dict, policy: dict) -> PolicyFinding:
    category = line.get("category")
    amount = float(line.get("amount", 0))
    cat_policy = policy["categories"].get(category, {})
    limit = cat_policy.get("limit")

    if limit is not None and amount > limit:
        return PolicyFinding(
            over_limit=True,
            limit=limit,
            needs_justification=True,
            message=f"{category} line of {amount:.0f} INR is over the {limit} INR limit; a justification is required.",
        )
    if category == "Client entertainment":
        return PolicyFinding(
            over_limit=False,
            limit=None,
            needs_justification=True,
            message="Client entertainment needs a pre-approval ID as justification.",
        )
    return PolicyFinding(over_limit=False, limit=limit, needs_justification=False, message="")


# ---- Categorical policy rules (beyond numeric limits) ------------------------
_ALCOHOL_TERMS = ["alcohol", "beer", "wine", "liquor", "whisky", "whiskey", "vodka", "rum", "cocktail", "bar tab"]


def check_category_rules(line: dict) -> GuardrailResult:
    """Non-numeric policy rules: alcohol is a hard reject; a Hotel line needs an itemised-bill note.

    A hard failure (ok=False) must not be filed. A soft flag is returned as ok=True with
    detail.needs_justification set, so the caller folds it into the justification requirement.
    """
    category = line.get("category")
    haystack = f"{line.get('merchant', '')} {line.get('notes', '')}".lower()

    if category == "Meals" and any(term in haystack for term in _ALCOHOL_TERMS):
        return GuardrailResult(False, "policy.alcohol", "Alcohol is not reimbursable on a Meals line.")

    if category == "Hotel" and not str(line.get("notes", "")).strip():
        return GuardrailResult(
            True,
            "policy.hotel_bill",
            detail={
                "needs_justification": True,
                "message": "Hotel lines require an itemised-bill reference in the notes before approval.",
            },
        )

    return GuardrailResult.passed("policy.category")


# ---- Duplicate (read-before-write) -------------------------------------------
def find_duplicate(line: dict, existing_reports: list[dict]) -> bool:
    for report in existing_reports:
        for existing in report.get("lines", []):
            if (
                existing.get("category") == line.get("category")
                and abs(float(existing.get("amount", 0)) - float(line.get("amount", 0))) < 0.01
                and existing.get("project_code") == line.get("project_code")
                and existing.get("date") == str(line.get("date"))
            ):
                return True
    return False
```

