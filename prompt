```jsx
import React, { useState } from 'react';
import { sendChat, approveAction, rejectAction, editAction } from './api';
import ConfirmationCard from './ConfirmationCard.jsx';
import RunsView from './RunsView.jsx';

export default function App() {
  const [message, setMessage] = useState('');
  const [thread, setThread] = useState([]);
  const [pending, setPending] = useState(null);
  const [busy, setBusy] = useState(false);
  const [error, setError] = useState('');
  const [runsKey, setRunsKey] = useState(0);

  const addTurn = (role, text) => setThread((t) => [...t, { role, text }]);
  const bumpRuns = () => setRunsKey((k) => k + 1);

  const run = async (fn) => {
    setBusy(true);
    setError('');
    try {
      return await fn();
    } catch (e) {
      setError(e.message);
      return null;
    } finally {
      setBusy(false);
      bumpRuns();
    }
  };

  const onSend = async () => {
    const text = message.trim();
    if (!text) return;
    addTurn('user', text);
    setMessage('');
    const res = await run(() => sendChat(text));
    if (!res) return;
    addTurn('agent', res.reply);
    setPending(res.pending_action || null);
  };

  const onApprove = async (action) => {
    const res = await run(() => approveAction(action.action_id, action.payload_hash));
    if (!res) return;
    addTurn('agent', res.reply);
    setPending(null);
  };

  const onReject = async (action) => {
    const res = await run(() => rejectAction(action.action_id, ''));
    if (!res) return;
    addTurn('agent', res.reply);
    setPending(null);
  };

  const onEdit = async (patches) => {
    const res = await run(() => editAction(pending.action_id, patches));
    if (!res) return;
    addTurn('agent', res.reply);
    setPending(res.pending_action || null);
  };

  return (
    <main className="app">
      <header className="top">
        <h1>FileMate</h1>
        <p className="sub">Expense filing assistant · signed in as Priya Nair (E1042)</p>
      </header>

      <div className="grid">
        <div className="left">
          <div className="thread" aria-live="polite">
            {thread.map((turn, i) => (
              <div key={i} className={`bubble ${turn.role}`}>
                <span className="who">{turn.role === 'user' ? 'You' : 'FileMate'}</span>
                <p>{turn.text}</p>
              </div>
            ))}
          </div>

          {pending && (
            <ConfirmationCard
              action={pending}
              onApprove={onApprove}
              onReject={onReject}
              onEdit={onEdit}
              busy={busy}
            />
          )}

          {error && <p className="warn" role="alert">{error}</p>}

          <div className="composer">
            <label htmlFor="msg" className="sr-only">Message</label>
            <textarea
              id="msg"
              rows="3"
              value={message}
              placeholder="Paste a receipt, e.g. Uber trip, Airport to office, 1250 INR, 28 Oct 2026, project ATLAS"
              onChange={(e) => setMessage(e.target.value)}
              onKeyDown={(e) => {
                if (e.key === 'Enter' && (e.metaKey || e.ctrlKey)) onSend();
              }}
            />
            <button className="btn primary" disabled={busy} onClick={onSend}>Send</button>
          </div>
        </div>

        <aside className="right">
          <RunsView refreshKey={runsKey} />
        </aside>
      </div>
    </main>
  );
}
