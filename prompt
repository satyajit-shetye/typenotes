## PHASE 5 — Agent tools and the LangGraph agent

Three read tools (run immediately) and three write tools (stage only, never call the API). The write tools coerce the model's args into the typed `ExpenseLine`, run the guardrails and policy checks, and stage the operation. The LangGraph agent wires model↔tools with logging, marks receipt text as data, and is given today's date.

**Create `filemate/backend/app/tools.py`** with exactly this content:

```python
"""Agent tools, mapped to the mock Expense API.

Five+ tools: three reads (get_project, get_policy, get_my_reports) and three
writes (create_report, add_expense_line, submit_report). Read tools call the API
directly. Write tools NEVER call the API here: they validate arguments and policy,
then *stage* the exact operation into the current session so the HITL gate can
turn it into a confirmation card. Only an approval later replays the staged ops.
"""

from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any

from langchain_core.tools import StructuredTool
from pydantic import ValidationError

from . import guardrails
from .config import SESSION_EMPLOYEE_ID
from .mock_expense_api import ExpenseApiError, MockExpenseApi
from .observability import Observatory, Run, Stopwatch
from .schemas import ExpenseLine


@dataclass
class AgentSession:
    """Per-request state shared across tool calls within one agent turn."""

    run: Run
    api: MockExpenseApi
    obs: Observatory
    staged_ops: list[dict[str, Any]] = field(default_factory=list)
    line_summaries: list[dict[str, Any]] = field(default_factory=list)
    needs_justification: bool = False
    injection_suspicious: bool = False

    def has_staged_writes(self) -> bool:
        return bool(self.staged_ops)


def _ok(status: str, payload: Any) -> str:
    return f"{status}: {payload}"


def build_tools(session: AgentSession) -> list[StructuredTool]:
    api = session.api
    obs = session.obs
    run = session.run

    # ---- Read tools ----------------------------------------------------------
    def get_project(code: str) -> str:
        """Look up a project by its code. Returns name, status (active/closed) and budget remaining."""
        with Stopwatch() as sw:
            try:
                result = api.get_project(code)
                status = "ok"
            except ExpenseApiError as exc:
                result = {"error": exc.message}
                status = f"error_{exc.status}"
        obs.log_tool(run, name="get_project", args={"code": code}, status=status, latency_ms=sw.elapsed_ms)
        return _ok(status, result)

    def get_policy() -> str:
        """Return the expense policy: category limits and rules."""
        with Stopwatch() as sw:
            result = api.get_policy()
        obs.log_tool(run, name="get_policy", args={}, status="ok", latency_ms=sw.elapsed_ms)
        return _ok("ok", result)

    def get_my_reports(employee_id: str = SESSION_EMPLOYEE_ID) -> str:
        """List the signed-in employee's existing expense reports and lines (for duplicate checks)."""
        scope = guardrails.check_read_scope(employee_id)
        if not scope.ok:
            obs.log_guardrail(run, check=scope.check, reason=scope.reason, detail=scope.detail)
            return _ok("refused", scope.reason)
        with Stopwatch() as sw:
            result = api.get_reports(SESSION_EMPLOYEE_ID)
        obs.log_tool(run, name="get_my_reports", args={"employee_id": SESSION_EMPLOYEE_ID}, status="ok", latency_ms=sw.elapsed_ms)
        return _ok("ok", result)

    # ---- Write tools (staged, never hit the API here) ------------------------
    def create_report() -> str:
        """Begin a new draft expense report. Staged for approval; nothing is written yet."""
        session.staged_ops.append({"tool": "create_report", "args": {"employee_id": SESSION_EMPLOYEE_ID}})
        obs.log_tool(run, name="create_report", args={}, status="staged", latency_ms=0.0)
        return _ok("staged", "A draft report will be created on approval.")

    def add_expense_line(
        date: str,
        merchant: str,
        category: str,
        amount: float,
        project_code: str,
        currency: str = "INR",
        notes: str = "",
        justification: str = "",
    ) -> str:
        """Add one expense line to the draft. Validated and policy-checked, then staged for approval."""
        # Extraction target: coerce the model's arguments into the typed schema first.
        try:
            extracted = ExpenseLine(
                date=date,
                merchant=merchant,
                category=category,
                amount=amount,
                currency=currency,
                project_code=project_code,
                notes=notes,
            )
        except ValidationError as exc:
            reason = "; ".join(f"{e['loc'][0]}: {e['msg']}" for e in exc.errors())
            obs.log_guardrail(run, check="arg.schema", reason=reason, detail={"errors": exc.error_count()})
            return _ok("rejected", f"The line does not fit the expense schema ({reason}).")
        line = extracted.model_dump(mode="json")

        arg_check = guardrails.validate_line_args(line, api)
        if not arg_check.ok:
            obs.log_guardrail(run, check=arg_check.check, reason=arg_check.reason, detail=arg_check.detail)
            return _ok("rejected", arg_check.reason)

        # Categorical rules: alcohol is a hard reject; Hotel without an itemised-bill note is flagged.
        rules = guardrails.check_category_rules(line)
        if not rules.ok:
            obs.log_guardrail(run, check=rules.check, reason=rules.reason, detail=rules.detail)
            return _ok("rejected", rules.reason)
        rule_message = rules.detail.get("message")
        rule_needs_justification = bool(rules.detail.get("needs_justification"))

        existing = api.get_reports(SESSION_EMPLOYEE_ID)
        duplicate = guardrails.find_duplicate(line, existing)

        finding = guardrails.policy_check(line, api.get_policy())
        has_justification = bool(justification.strip())
        needs_justification_required = finding.needs_justification or rule_needs_justification
        line_needs_justification = needs_justification_required and not has_justification
        if line_needs_justification:
            session.needs_justification = True

        staged_line = {**line, "justification": justification}
        session.staged_ops.append({"tool": "add_line", "args": staged_line})
        summary = {
            **line,
            "justification": justification or None,
            "over_limit": finding.over_limit,
            "limit": finding.limit,
            "needs_justification": line_needs_justification,
            "duplicate_warning": duplicate,
            "policy_message": finding.message or rule_message or None,
        }
        session.line_summaries.append(summary)

        status = "staged"
        notes_out = []
        if finding.over_limit:
            notes_out.append(finding.message)
        if rule_message:
            notes_out.append(rule_message)
        if needs_justification_required and not has_justification:
            notes_out.append("A justification is required before approval.")
        if duplicate:
            notes_out.append("This looks like a duplicate of an existing line; warn the user.")
        obs.log_tool(
            run,
            name="add_expense_line",
            args={**staged_line},
            status="staged",
            latency_ms=0.0,
        )
        return _ok(status, {"line": {**line, "justification": justification}, "notes": notes_out})

    def submit_report() -> str:
        """Submit the draft report to Finance. Staged for approval; nothing is submitted yet."""
        session.staged_ops.append({"tool": "submit_report", "args": {}})
        obs.log_tool(run, name="submit_report", args={}, status="staged", latency_ms=0.0)
        return _ok("staged", "The report will be submitted on approval.")

    return [
        StructuredTool.from_function(get_project),
        StructuredTool.from_function(get_policy),
        StructuredTool.from_function(get_my_reports),
        StructuredTool.from_function(create_report),
        StructuredTool.from_function(add_expense_line),
        StructuredTool.from_function(submit_report),
    ]
