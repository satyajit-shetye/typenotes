## PHASE 2 — Observability (structured JSON logging, trace ids, run registry)

The logging backbone every later phase writes through: one JSON line per event, a shared trace id, masked personal data, and a last-10-runs registry.

**Create `filemate/backend/app/observability.py`** with exactly this content:

```python
"""Observability: one structured JSON log line per event, all sharing a trace ID.

Every user request opens a Run with a trace_id. LLM calls, tool calls, guardrail
blocks and HITL decisions are logged as JSON lines to stdout and also retained in
memory so `GET /runs` can show the last 10 runs. Personal data in tool arguments
is masked before logging.
"""

from __future__ import annotations

import json
import re
import sys
import time
import uuid
from collections import deque
from dataclasses import dataclass, field
from typing import Any

# Event types, shared vocabulary across the whole app.
EVT_USER_REQUEST = "user_request"
EVT_LLM_CALL = "llm_call"
EVT_TOOL_CALL = "tool_call"
EVT_GUARDRAIL_BLOCK = "guardrail_block"
EVT_HITL_DECISION = "hitl_decision"
EVT_AGENT_REPLY = "agent_reply"

_EMPLOYEE_RE = re.compile(r"\bE\d{3,}\b")
_PII_KEYS = {"employee_id", "notes", "merchant", "message", "receipt_text"}


def _now_ms() -> float:
    return time.perf_counter() * 1000.0


def mask_pii(value: Any) -> Any:
    """Mask employee IDs and free-text fields that may carry personal data."""
    if isinstance(value, dict):
        return {k: (_mask_scalar(v) if k in _PII_KEYS else mask_pii(v)) for k, v in value.items()}
    if isinstance(value, list):
        return [mask_pii(v) for v in value]
    return value


def _mask_scalar(value: Any) -> Any:
    if not isinstance(value, str):
        return value
    masked = _EMPLOYEE_RE.sub("E****", value)
    if len(masked) > 40:
        masked = masked[:40] + "...<masked>"
    return masked


@dataclass
class Run:
    trace_id: str
    employee_id: str
    started_at: float = field(default_factory=time.time)
    events: list[dict[str, Any]] = field(default_factory=list)
    total_latency_ms: float = 0.0
    input_tokens: int = 0
    output_tokens: int = 0
    tools_called: list[str] = field(default_factory=list)
    approvals: int = 0
    rejections: int = 0
    _open: float = field(default_factory=_now_ms, repr=False)

    @property
    def total_tokens(self) -> int:
        return self.input_tokens + self.output_tokens

    def summary(self) -> dict[str, Any]:
        return {
            "trace_id": self.trace_id,
            "started_at": self.started_at,
            "total_latency_ms": round(self.total_latency_ms, 1),
            "total_tokens": self.total_tokens,
            "input_tokens": self.input_tokens,
            "output_tokens": self.output_tokens,
            "tools_called": self.tools_called,
            "approvals": self.approvals,
            "rejections": self.rejections,
        }


class Observatory:
    """Holds the last N runs and emits JSON log lines."""

    def __init__(self, keep: int = 10) -> None:
        self._runs: deque[Run] = deque(maxlen=keep)
        self._by_id: dict[str, Run] = {}

    def start_run(self, employee_id: str) -> Run:
        run = Run(trace_id=str(uuid.uuid4()), employee_id=employee_id)
        self._runs.append(run)
        self._by_id[run.trace_id] = run
        # Keep the id index bounded to what the deque still holds.
        live = {r.trace_id for r in self._runs}
        for tid in list(self._by_id):
            if tid not in live:
                del self._by_id[tid]
        self.log(run, EVT_USER_REQUEST, employee_id=employee_id)
        return run

    def get(self, trace_id: str) -> Run | None:
        return self._by_id.get(trace_id)

    def last_runs(self) -> list[dict[str, Any]]:
        return [r.summary() for r in reversed(self._runs)]

    def log(self, run: Run, event: str, *, latency_ms: float | None = None, **fields: Any) -> dict[str, Any]:
        entry = {
            "ts": round(time.time(), 3),
            "trace_id": run.trace_id,
            "event": event,
            **mask_pii(fields),
        }
        if latency_ms is not None:
            entry["latency_ms"] = round(latency_ms, 1)
            run.total_latency_ms += latency_ms
        run.events.append(entry)
        sys.stdout.write(json.dumps(entry) + "\n")
        sys.stdout.flush()
        return entry

    def log_llm(self, run: Run, *, model: str, input_tokens: int, output_tokens: int, latency_ms: float) -> None:
        run.input_tokens += input_tokens
        run.output_tokens += output_tokens
        self.log(
            run,
            EVT_LLM_CALL,
            model=model,
            input_tokens=input_tokens,
            output_tokens=output_tokens,
            latency_ms=latency_ms,
        )

    def log_tool(self, run: Run, *, name: str, args: dict[str, Any], status: str, latency_ms: float) -> None:
        run.tools_called.append(name)
        self.log(run, EVT_TOOL_CALL, tool=name, args=args, status=status, latency_ms=latency_ms)

    def log_guardrail(self, run: Run, *, check: str, reason: str, detail: dict[str, Any] | None = None) -> None:
        self.log(run, EVT_GUARDRAIL_BLOCK, check=check, reason=reason, detail=detail or {})

    def log_hitl(self, run: Run, *, decision: str, action_id: str, **extra: Any) -> None:
        if decision == "approve":
            run.approvals += 1
        elif decision == "reject":
            run.rejections += 1
        self.log(run, EVT_HITL_DECISION, decision=decision, action_id=action_id, **extra)


# Timing helper used by tool and LLM call sites.
class Stopwatch:
    def __enter__(self) -> "Stopwatch":
        self._start = _now_ms()
        self.elapsed_ms = 0.0
        return self

    def __exit__(self, *exc: object) -> None:
        self.elapsed_ms = _now_ms() - self._start
```

