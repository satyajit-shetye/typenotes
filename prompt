```python
"""In-memory stub of the Expense API, with the seed data and policy from the brief.

This stands in for the real expense system. It only does reads and writes; all
policy *enforcement* lives in guardrails, not here, so that the controls are
visible in our own code rather than hidden behind the API.
"""

from __future__ import annotations

import uuid
from dataclasses import dataclass, field
from datetime import date, timedelta
from typing import Any


class ExpenseApiError(Exception):
    """Raised for not-found / bad-state conditions, like an HTTP 4xx from a real API."""

    def __init__(self, status: int, message: str) -> None:
        super().__init__(message)
        self.status = status
        self.message = message


# ---- Policy (returned by GET /policy) ----------------------------------------
POLICY: dict[str, Any] = {
    "categories": {
        "Meals": {"limit": 1500, "period": "day", "rule": "Alcohol is not reimbursable"},
        "Local travel": {"limit": 3000, "period": "trip", "rule": "Taxi, rideshare, metro"},
        "Hotel": {"limit": 7000, "period": "night", "rule": "Itemised bill required"},
        "Client entertainment": {"limit": None, "period": None, "rule": "Needs a pre-approval ID"},
    },
    "all_categories": {
        "max_age_days": 60,
        "future_dates_allowed": False,
        "currency": "INR",
        "rule": "Receipt date within the last 60 days and not in the future; currency INR only",
    },
}


@dataclass
class ReportLine:
    date: str
    merchant: str
    category: str
    amount: float
    currency: str
    project_code: str
    notes: str = ""


@dataclass
class Report:
    id: str
    employee_id: str
    status: str  # draft | submitted
    lines: list[ReportLine] = field(default_factory=list)

    def to_dict(self) -> dict[str, Any]:
        return {
            "id": self.id,
            "employee_id": self.employee_id,
            "status": self.status,
            "lines": [vars(line) for line in self.lines],
        }


class MockExpenseApi:
    def __init__(self) -> None:
        self._projects: dict[str, dict[str, Any]] = {}
        self._reports: dict[str, Report] = {}
        self._seed()

    def _seed(self) -> None:
        self._projects = {
            "ATLAS": {"code": "ATLAS", "name": "Project ATLAS", "status": "active", "budget_remaining": 240000},
            "ORION": {"code": "ORION", "name": "Project ORION", "status": "closed", "budget_remaining": 0},
        }
        three_days_ago = (date.today() - timedelta(days=3)).isoformat()
        seed_report = Report(
            id="RPT-SEED-1",
            employee_id="E1042",
            status="submitted",
            lines=[
                ReportLine(
                    date=three_days_ago,
                    merchant="Cafe Mocha",
                    category="Meals",
                    amount=980,
                    currency="INR",
                    project_code="ATLAS",
                    notes="Existing submitted line",
                )
            ],
        )
        self._reports = {seed_report.id: seed_report}

    # ---- Read endpoints ------------------------------------------------------
    def get_project(self, code: str) -> dict[str, Any]:
        project = self._projects.get(code.upper())
        if not project:
            raise ExpenseApiError(404, f"Project {code!r} not found")
        return dict(project)

    def get_policy(self) -> dict[str, Any]:
        return POLICY

    def get_reports(self, employee_id: str) -> list[dict[str, Any]]:
        return [r.to_dict() for r in self._reports.values() if r.employee_id == employee_id]

    # ---- Write endpoints -----------------------------------------------------
    def create_report(self, employee_id: str) -> dict[str, Any]:
        report = Report(id=f"RPT-{uuid.uuid4().hex[:8].upper()}", employee_id=employee_id, status="draft")
        self._reports[report.id] = report
        return {"id": report.id, "status": report.status}

    def add_line(self, report_id: str, line: dict[str, Any]) -> dict[str, Any]:
        report = self._require_report(report_id)
        if report.status != "draft":
            raise ExpenseApiError(409, f"Report {report_id} is not a draft")
        report.lines.append(ReportLine(**{k: line[k] for k in ReportLine.__annotations__ if k in line}))
        return {"id": report.id, "line_count": len(report.lines)}

    def submit_report(self, report_id: str) -> dict[str, Any]:
        report = self._require_report(report_id)
        if report.status != "draft":
            raise ExpenseApiError(409, f"Report {report_id} is not a draft")
        if not report.lines:
            raise ExpenseApiError(400, f"Report {report_id} has no lines")
        report.status = "submitted"
        return {"id": report.id, "status": report.status}

    def _require_report(self, report_id: str) -> Report:
        report = self._reports.get(report_id)
        if not report:
            raise ExpenseApiError(404, f"Report {report_id} not found")
        return report
```

