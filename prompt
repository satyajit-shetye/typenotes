"""FastAPI app: the only surface the frontend talks to.

The frontend never calls the LLM or the Expense API directly. It calls:
  POST /chat                     - send a message, get a reply and maybe a card
  POST /actions/{id}/approve     - execute the stored payload
  POST /actions/{id}/reject      - discard it, hand back to the agent
  POST /actions/{id}/edit        - supersede with an edited payload (new card)
  GET  /runs                     - last 10 runs for the observability view
"""

from __future__ import annotations

import re
from typing import Any

from dotenv import load_dotenv
from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware

from . import guardrails
from .config import SESSION_EMPLOYEE_ID, SESSION_EMPLOYEE_NAME, load_settings
from .executor import ExecutionError, execute
from .hitl import STATUS_PENDING, HitlError, HitlStore
from .mock_expense_api import MockExpenseApi
from .observability import Observatory
from .schemas import ChatRequest, EditRequest, RejectRequest
from .tools import AgentSession

load_dotenv()

settings = load_settings()
api = MockExpenseApi()
obs = Observatory(keep=10)
hitl = HitlStore()

app = FastAPI(title="FileMate", version="1.0.0")
app.add_middleware(
    CORSMiddleware,
    allow_origins=["http://localhost:5173", "http://127.0.0.1:5173"],
    allow_methods=["*"],
    allow_headers=["*"],
)


def _is_add_line(op: dict[str, Any]) -> bool:
    return op.get("tool") == "add_line"


# Output check: nothing is filed during /chat, so any "filed" claim from the model is false.
_FILED_CLAIM = re.compile(r"\b(filed|submitted|has been (filed|submitted))\b", re.IGNORECASE)


def _strip_false_filing_claim(reply: str) -> str:
    if _FILED_CLAIM.search(reply):
        return "I've prepared your request, but nothing has been filed yet — it needs your approval first."
    return reply


def _assemble_write_payload(staged_ops: list[dict[str, Any]]) -> list[dict[str, Any]]:
    """Build a guaranteed-valid create -> line(s) -> submit sequence from the staged lines.

    The model may call the write tools out of order or skip create/submit; we ignore
    that order and assemble a coherent payload from the staged add_line operations, so
    the approved action always executes correctly (or there is nothing to file).
    """
    line_ops = [op for op in staged_ops if _is_add_line(op)]
    if not line_ops:
        return []
    return (
        [{"tool": "create_report", "args": {"employee_id": SESSION_EMPLOYEE_ID}}]
        + line_ops
        + [{"tool": "submit_report", "args": {}}]
    )


def _rebuild_summary(op_args: dict[str, Any]) -> dict[str, Any]:
    finding = guardrails.policy_check(op_args, api.get_policy())
    rules = guardrails.check_category_rules(op_args)
    rule_needs = bool(rules.detail.get("needs_justification"))
    rule_message = rules.detail.get("message")
    has_justification = bool(str(op_args.get("justification", "")).strip())
    line_needs = (finding.needs_justification or rule_needs) and not has_justification
    return {
        "date": op_args.get("date"),
        "merchant": op_args.get("merchant"),
        "category": op_args.get("category"),
        "amount": op_args.get("amount"),
        "currency": op_args.get("currency"),
        "project_code": op_args.get("project_code"),
        "notes": op_args.get("notes"),
        "justification": op_args.get("justification") or None,
        "over_limit": finding.over_limit,
        "limit": finding.limit,
        "needs_justification": line_needs,
        "policy_message": finding.message or rule_message or None,
    }


@app.get("/health")
def health() -> dict[str, Any]:
    return {"status": "ok", "llm": settings.has_llm, "model": settings.model, "employee": SESSION_EMPLOYEE_ID}


@app.post("/chat")
def chat(req: ChatRequest) -> dict[str, Any]:
    # 1) Input guardrails, before any LLM call.
    input_check = guardrails.check_input(req.message)
    if not input_check.ok:
        run = obs.start_run(SESSION_EMPLOYEE_ID)
        obs.log_guardrail(run, check=input_check.check, reason=input_check.reason, detail=input_check.detail)
        return {"trace_id": run.trace_id, "reply": input_check.reason, "blocked": True, "pending_action": None}

    # 2) Scope / authorization, before any LLM call.
    scope = guardrails.check_scope(req.message)
    if not scope.ok:
        run = obs.start_run(SESSION_EMPLOYEE_ID)
        obs.log_guardrail(run, check=scope.check, reason=scope.reason, detail=scope.detail)
        return {"trace_id": run.trace_id, "reply": scope.reason, "blocked": True, "pending_action": None}

    run = obs.start_run(SESSION_EMPLOYEE_ID)

    # 3) Injection detection: receipt text is data; log suspicious content and carry on.
    injection = guardrails.detect_injection(req.message)
    if injection.detail.get("suspicious"):
        obs.log_guardrail(run, check=injection.check, reason=injection.reason, detail=injection.detail)

    if not settings.has_llm:
        raise HTTPException(status_code=503, detail="OPENAI_API_KEY is not set; the agent cannot run.")

    session = AgentSession(run=run, api=api, obs=obs)
    session.injection_suspicious = bool(injection.detail.get("suspicious"))

    from .agent import run_agent  # imported lazily so tests need no OpenAI key

    agent_reply = run_agent(session, settings, req.message)

    operations = _assemble_write_payload(session.staged_ops)
    if not operations:
        reply = _strip_false_filing_claim(agent_reply)
        obs.log(run, "agent_reply", text=reply)
        return {"trace_id": run.trace_id, "reply": reply, "blocked": False, "pending_action": None}

    action = hitl.create(
        trace_id=run.trace_id,
        operations=operations,
        summary={"lines": session.line_summaries, "injection_suspicious": session.injection_suspicious},
        needs_justification=session.needs_justification,
    )
    line_count = sum(1 for op in operations if _is_add_line(op))
    reply = f"I've prepared a report with {line_count} line(s). Review the card and approve to file it."
    if session.needs_justification:
        reply += " One or more lines need a justification before they can be approved."
    obs.log(run, "agent_reply", text=reply)
    return {"trace_id": run.trace_id, "reply": reply, "blocked": False, "pending_action": action.card()}


@app.post("/actions/{action_id}/approve")
def approve(action_id: str, body: dict[str, Any] | None = None) -> dict[str, Any]:
    expected_hash = (body or {}).get("payload_hash")
    try:
        action = hitl.approve(action_id, expected_hash=expected_hash)
    except HitlError as exc:
        raise HTTPException(status_code=409, detail=exc.message)

    run = obs.get(action.trace_id) or obs.start_run(SESSION_EMPLOYEE_ID)
    obs.log_hitl(run, decision="approve", action_id=action_id)
    try:
        result = execute(action.operations, api=api, obs=obs, run=run)
    except ExecutionError as exc:
        raise HTTPException(status_code=502, detail=exc.message)

    reply = f"Filed. Report {result['report_id']} with {result['line_count']} line(s) was submitted to Finance."
    obs.log(run, "agent_reply", text=reply)
    return {"trace_id": run.trace_id, "reply": reply, "result": result}


@app.post("/actions/{action_id}/reject")
def reject(action_id: str, body: RejectRequest | None = None) -> dict[str, Any]:
    try:
        action = hitl.reject(action_id)
    except HitlError as exc:
        raise HTTPException(status_code=409, detail=exc.message)
    run = obs.get(action.trace_id) or obs.start_run(SESSION_EMPLOYEE_ID)
    reason = (body.reason if body else "") or ""
    obs.log_hitl(run, decision="reject", action_id=action_id, reason=reason)
    reply = "Okay, I won't file that. What would you like to change?"
    obs.log(run, "agent_reply", text=reply)
    return {"trace_id": run.trace_id, "reply": reply}


@app.post("/actions/{action_id}/edit")
def edit(action_id: str, body: EditRequest) -> dict[str, Any]:
    try:
        old = hitl.get(action_id)
    except HitlError as exc:
        raise HTTPException(status_code=404, detail=exc.message)
    if old.status != STATUS_PENDING:
        raise HTTPException(status_code=409, detail=f"Action {action_id} is {old.status}; only a pending action can be edited.")

    # Build a fresh operations list from the old one with the patches applied.
    new_ops = [{"tool": op["tool"], "args": dict(op["args"])} for op in old.operations]
    add_line_positions = [i for i, op in enumerate(new_ops) if _is_add_line(op)]
    for patch in body.patches:
        if patch.line_index < 0 or patch.line_index >= len(add_line_positions):
            raise HTTPException(status_code=400, detail=f"No line at index {patch.line_index}")
        args = new_ops[add_line_positions[patch.line_index]]["args"]
        if patch.amount is not None:
            args["amount"] = patch.amount
        if patch.category is not None:
            args["category"] = patch.category.value
        if patch.project_code is not None:
            args["project_code"] = patch.project_code
        if patch.notes is not None:
            args["notes"] = patch.notes
        if patch.justification is not None:
            args["justification"] = patch.justification

    # Re-validate and re-check policy on the edited lines.
    summaries: list[dict[str, Any]] = []
    needs_justification = False
    for op in new_ops:
        if not _is_add_line(op):
            continue
        arg_check = guardrails.validate_line_args(op["args"], api)
        if not arg_check.ok:
            raise HTTPException(status_code=400, detail=arg_check.reason)
        rules = guardrails.check_category_rules(op["args"])
        if not rules.ok:
            raise HTTPException(status_code=400, detail=rules.reason)
        summary = _rebuild_summary(op["args"])
        needs_justification = needs_justification or summary["needs_justification"]
        summaries.append(summary)

    run = obs.get(old.trace_id) or obs.start_run(SESSION_EMPLOYEE_ID)
    new_action = hitl.create(
        trace_id=old.trace_id,
        operations=new_ops,
        summary={"lines": summaries, "injection_suspicious": old.summary.get("injection_suspicious", False)},
        needs_justification=needs_justification,
    )
    hitl.supersede(action_id, new_action.id)
    obs.log_hitl(run, decision="edit", action_id=action_id, new_action_id=new_action.id)
    reply = "Updated. Review the revised card and approve to file it."
    if needs_justification:
        reply += " A justification is still required."
    return {"trace_id": run.trace_id, "reply": reply, "pending_action": new_action.card()}


@app.get("/runs")
def runs() -> dict[str, Any]:
    return {"employee": {"id": SESSION_EMPLOYEE_ID, "name": SESSION_EMPLOYEE_NAME}, "runs": obs.last_runs()}
